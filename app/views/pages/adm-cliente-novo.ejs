            <% }) %>
        </ul>
    </div>
<% } %>
 
        <form action="" method="post">

              <%- include("../partials/form-cliente") -%>
        </form>

        <div>
            <a class="btn btn-primary btn-lg" href="/adm/adm-cliente-novo" role="button">voltar</a>

        </div>

        <hr />
            <%- include("../partials/footer-adm") -%>
    </div>
</body>

</html>